DB=

CORS_ALLOWED_ORIGINS=http://localhost:5173

PISTON_BASE_URL=http://localhost:2000
PISTON_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SLOT_HOLD_MINUTES=10

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Exam invitation email (SMTP). Leave SMTP_HOST empty to log mail in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:5173
AUTO_SEND_EXAM_INVITATION=false

# Public applicant signup: email/mobile OTP verification
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_VERIFIED_TTL_MINUTES=30
# "console" logs the SMS instead of sending it (see utils/sms.py) until a
# real provider (Twilio, MSG91, etc.) is wired up there.
SMS_PROVIDER=console

# Local-disk storage for applicant documents (marksheets/age proof) and
# proctoring snapshots, served back at BACKEND_PUBLIC_URL/uploads/*.
UPLOAD_DIR=uploads
BACKEND_PUBLIC_URL=http://localhost:8000

# scripts/send_exam_reminders.py: how far ahead of an exam to send the
# "your exam starts soon" reminder mail. Run the script on a schedule
# (cron / Task Scheduler), e.g. hourly.
EXAM_REMINDER_HOURS_BEFORE=24
